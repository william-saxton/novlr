{
	"name": "novelr",
	"version": "0.1.2",
	"description": "Obsidian plugin for long-form writing with user-defined structure and a type-aware compile pipeline.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "svelte-check --tsconfig tsconfig.json && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"writing",
		"novel"
	],
	"license": "Apache-2.0",
	"dependencies": {
		"sortablejs": "^1.15.7"
	},
	"devDependencies": {
		"@types/node": "^22.15.17",
		"@types/sortablejs": "^1.15.9",
		"esbuild": "^0.28.2",
		"esbuild-svelte": "^0.9.5",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.12.0",
		"jiti": "^2.7.0",
		"obsidian": "^1.13.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.70.0",
		"vitest": "^5.0.1"
	},
	"author": "William Saxton",
	"repository": {
		"type": "git",
		"url": "https://github.com/william-saxton/novlr.git"
	},
	"homepage": "https://github.com/william-saxton/novlr#readme"
}
